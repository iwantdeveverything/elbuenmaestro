---
interface Props {
  title: string;
  subtitle?: string;
  roleBadge?: string;
  activeNav?: 'admin' | 'maestro' | 'cliente';
}

const { title, subtitle, roleBadge = 'Control de Obra', activeNav } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | El Buen Maestro</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="platform-header">
      <div class="platform-container header-row">
        <a href="/" class="brand-link">
          <span class="brand-icon">👷‍♂️</span>
          <div>
            <span class="brand-name">El Buen Maestro</span>
            <span class="brand-badge">{roleBadge}</span>
          </div>
        </a>
        <nav class="platform-nav" aria-label="Accesos de plataforma">
          <a href="/admin" class:list={['nav-pill', { active: activeNav === 'admin' }]}>
            Panel Admin
          </a>
          <a href="/maestro" class:list={['nav-pill', { active: activeNav === 'maestro' }]}>
            Portal Maestro
          </a>
          <a href="/" class="nav-pill nav-pill-ghost">Sitio Público ↗</a>
        </nav>
      </div>
    </header>

    <main class="platform-main">
      <div class="platform-container">
        <div class="page-head">
          <h1>{title}</h1>
          {subtitle && <p class="page-subtitle">{subtitle}</p>}
        </div>
        <slot />
      </div>
    </main>

    <style is:global>
      :root {
        --bg-dark: #0b0d10;
        --bg-card: #13171e;
        --bg-card-elevated: #19202b;
        --border: #243044;
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
        --primary: #f59e0b;
        --primary-hover: #d97706;
        --success: #10b981;
        --info: #3b82f6;
        --warning: #f59e0b;
        --danger: #ef4444;
        --purple: #8b5cf6;
        --font-heading: 'Outfit', sans-serif;
        --font-body: 'Plus Jakarta Sans', system-ui, sans-serif;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background-color: var(--bg-dark);
        color: var(--text-main);
        font-family: var(--font-body);
        line-height: 1.5;
        min-height: 100vh;
      }

      .platform-container {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 1.25rem;
      }

      .platform-header {
        background: rgba(19, 23, 30, 0.92);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 50;
        padding: 0.85rem 0;
      }

      .header-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
      }

      .brand-link {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        text-decoration: none;
        color: var(--text-main);
      }

      .brand-icon {
        font-size: 1.65rem;
      }

      .brand-name {
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 1.15rem;
        display: block;
      }

      .brand-badge {
        display: inline-block;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--primary);
        font-weight: 700;
      }

      .platform-nav {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
      }

      .nav-pill {
        text-decoration: none;
        color: var(--text-muted);
        font-size: 0.85rem;
        font-weight: 600;
        padding: 0.45rem 0.85rem;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--bg-card);
        transition: all 0.18s ease;
      }

      .nav-pill:hover,
      .nav-pill.active {
        color: #0b0d10;
        background: var(--primary);
        border-color: var(--primary);
      }

      .nav-pill-ghost {
        border-color: transparent;
        background: transparent;
      }

      .nav-pill-ghost:hover {
        background: var(--bg-card-elevated);
        color: var(--text-main);
        border-color: var(--border);
      }

      .platform-main {
        padding: 2rem 0 4rem;
      }

      .page-head {
        margin-bottom: 1.75rem;
      }

      .page-head h1 {
        font-family: var(--font-heading);
        font-size: clamp(1.6rem, 3vw + 0.5rem, 2.25rem);
        font-weight: 800;
        color: var(--text-main);
      }

      .page-subtitle {
        color: var(--text-muted);
        font-size: 0.98rem;
        margin-top: 0.35rem;
      }

      /* Shared Platform UI Components */
      .p-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 1.35rem;
        margin-bottom: 1.25rem;
      }

      .p-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
        padding-bottom: 0.85rem;
        border-bottom: 1px solid var(--border);
      }

      .p-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.3rem 0.7rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.02em;
      }

      .p-grid-2 {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
      }

      .p-grid-3 {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
      }

      @media (min-width: 768px) {
        .p-grid-2 {
          grid-template-columns: 1fr 1fr;
        }
        .p-grid-3 {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      .p-label {
        display: block;
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--text-muted);
        margin-bottom: 0.35rem;
      }

      .p-input,
      .p-select,
      .p-textarea {
        width: 100%;
        background: #0b0d10;
        color: var(--text-main);
        border: 1px solid var(--border);
        border-radius: 9px;
        padding: 0.65rem 0.85rem;
        font-family: inherit;
        font-size: 0.95rem;
      }

      .p-input:focus,
      .p-select:focus,
      .p-textarea:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.25);
      }

      .p-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        padding: 0.7rem 1.2rem;
        border-radius: 9px;
        font-weight: 700;
        font-size: 0.92rem;
        border: none;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.18s ease;
        font-family: inherit;
      }

      .p-btn-primary {
        background: var(--primary);
        color: #0b0d10;
      }

      .p-btn-primary:hover {
        background: var(--primary-hover);
      }

      .p-btn-whatsapp {
        background: #25d366;
        color: #052e16;
      }

      .p-btn-whatsapp:hover {
        background: #1ea952;
      }

      .p-btn-secondary {
        background: var(--bg-card-elevated);
        color: var(--text-main);
        border: 1px solid var(--border);
      }

      .p-btn-secondary:hover {
        border-color: var(--primary);
      }

      .signature-pad-wrapper {
        background: #ffffff;
        border-radius: 10px;
        border: 2px dashed #94a3b8;
        padding: 0.4rem;
        text-align: center;
      }

      .signature-canvas {
        width: 100%;
        height: 150px;
        touch-action: none;
        cursor: crosshair;
        display: block;
        background: #ffffff;
        border-radius: 6px;
      }
    </style>
  </body>
</html>
