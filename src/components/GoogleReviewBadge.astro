---
import googleReviewsData from '../data/googleReviews.json';

const { overallRating, totalReviews, googleMapsUrl } = googleReviewsData;
---

<aside class="google-review-badge" aria-label="Calificación de Google Reviews">
  <a
    href={googleMapsUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="badge-link"
    title={`Ver las ${totalReviews} opiniones en Google Maps`}
  >
    <div class="google-icon-wrapper">
      <svg class="google-logo" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path
          fill="#4285F4"
          d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
        ></path>
        <path
          fill="#34A853"
          d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
        ></path>
        <path
          fill="#FBBC05"
          d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
        ></path>
        <path
          fill="#EA4335"
          d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
        ></path>
      </svg>
    </div>
    <div class="badge-content">
      <div class="badge-top-row">
        <span class="rating-score">{overallRating}</span>
        <div class="stars-row" aria-label={`Calificación ${overallRating} de 5 estrellas`}>
          {Array.from({ length: 5 }).map(() => (
            <span class="star-icon">★</span>
          ))}
        </div>
        <span class="reviews-count">({totalReviews} opiniones)</span>
      </div>
      <div class="badge-bottom-row">
        <span class="link-label">Ver en Google</span>
        <svg class="external-arrow" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </div>
    </div>
  </a>
</aside>

<style>
  .google-review-badge {
    position: fixed;
    bottom: 1.5rem;
    left: 1.5rem;
    z-index: 99;
    font-family: var(--font-body, system-ui, sans-serif);
  }

  .badge-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.95rem;
    background-color: rgba(19, 23, 30, 0.88);
    backdrop-filter: var(--glass-blur, blur(16px));
    -webkit-backdrop-filter: var(--glass-blur, blur(16px));
    border: 1px solid rgba(245, 158, 11, 0.35);
    border-radius: 12px;
    color: var(--text-dark, #f1f5f9);
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35), 0 0 12px rgba(245, 158, 11, 0.1);
    transition: transform var(--duration-fast, 200ms) var(--ease-spring, cubic-bezier(0.16, 1, 0.3, 1)),
                border-color var(--duration-fast, 200ms) ease,
                box-shadow var(--duration-fast, 200ms) ease;
  }

  .badge-link:hover {
    transform: translateY(-2px);
    border-color: var(--primary, #f59e0b);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45), 0 0 20px rgba(245, 158, 11, 0.25);
  }

  .google-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    padding: 0.35rem;
    flex-shrink: 0;
  }

  .badge-content {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .badge-top-row {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
  }

  .rating-score {
    font-family: var(--font-heading, sans-serif);
    font-weight: 700;
    color: #ffffff;
    font-size: 0.95rem;
  }

  .stars-row {
    display: flex;
    gap: 0.05rem;
    color: var(--primary, #f59e0b);
    font-size: 0.85rem;
    line-height: 1;
  }

  .reviews-count {
    color: var(--text-muted, #94a3b8);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .badge-bottom-row {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.72rem;
    color: var(--primary, #f59e0b);
    font-weight: 500;
  }

  .link-label {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .external-arrow {
    transition: transform 0.2s ease;
  }

  .badge-link:hover .external-arrow {
    transform: translate(1px, -1px);
  }

  @media (max-width: 640px) {
    .google-review-badge {
      bottom: 1rem;
      left: 1rem;
    }
    .badge-link {
      padding: 0.5rem 0.75rem;
    }
  }
</style>
