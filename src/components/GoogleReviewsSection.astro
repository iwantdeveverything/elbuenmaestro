---
import googleReviewsData from '../data/googleReviews.json';

const { overallRating, totalReviews, googleMapsUrl, reviews } = googleReviewsData;
---

<section class="google-reviews-section" id="resenas">
  <div class="container">
    <div class="reviews-header">
      <div class="header-content">
        <span class="section-tag">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path
              fill="#4285F4"
              d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
            ></path>
            <path
              fill="#34A853"
              d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            ></path>
            <path
              fill="#FBBC05"
              d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
            ></path>
            <path
              fill="#EA4335"
              d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
            ></path>
          </svg>
          Google Reviews
        </span>
        <h2>Lo que dicen nuestros clientes en Google</h2>
        <div class="summary-badge">
          <span class="rating-number">{overallRating}</span>
          <div class="stars-gold" aria-label={`Calificación ${overallRating} de 5 estrellas`}>
            {Array.from({ length: 5 }).map(() => (
              <span class="star-icon">★</span>
            ))}
          </div>
          <span class="summary-text">basadas en <strong>{totalReviews} reseñas</strong></span>
        </div>
      </div>
      <a
        href={googleMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-maps-external"
      >
        <span>Ver perfil en Google Maps</span>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>
    </div>

    <div class="reviews-grid">
      {reviews.map((review) => (
        <article class="review-card">
          <div class="card-header">
            <img
              src={review.authorPhoto || review.avatar}
              alt={`Foto de perfil de ${review.authorName || review.author}`}
              class="author-avatar"
              loading="lazy"
              width="48"
              height="48"
            />
            <div class="author-meta">
              <h3 class="author-name">{review.authorName || review.author}</h3>
              <span class="review-date">{review.relativeTime}</span>
            </div>
            <div class="google-badge-mini" title="Reseña verificada en Google">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path
                  fill="#4285F4"
                  d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                ></path>
                <path
                  fill="#34A853"
                  d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                ></path>
                <path
                  fill="#FBBC05"
                  d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
                ></path>
                <path
                  fill="#EA4335"
                  d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
                ></path>
              </svg>
            </div>
          </div>

          <div class="card-rating" aria-label={`Calificación ${review.rating} de 5 estrellas`}>
            {Array.from({ length: review.rating }).map(() => (
              <span class="star-icon">★</span>
            ))}
          </div>

          <p class="review-text">"{review.text}"</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .google-reviews-section {
    padding: 4rem 0;
    background-color: rgba(11, 13, 16, 0.6);
    border-top: 1px solid var(--border-color, #1e293b);
    border-bottom: 1px solid var(--border-color, #1e293b);
  }

  .reviews-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .section-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    background-color: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.25);
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--primary, #f59e0b);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .reviews-header h2 {
    font-family: var(--font-heading, sans-serif);
    font-size: var(--font-size-h2, 2rem);
    font-weight: 800;
    color: var(--text-dark, #f1f5f9);
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .summary-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
  }

  .rating-number {
    font-family: var(--font-heading, sans-serif);
    font-weight: 800;
    font-size: 1.25rem;
    color: #ffffff;
  }

  .stars-gold {
    display: flex;
    gap: 0.1rem;
    color: var(--primary, #f59e0b);
    font-size: 1.1rem;
  }

  .summary-text {
    color: var(--text-muted, #94a3b8);
  }

  .summary-text strong {
    color: var(--text-dark, #f1f5f9);
  }

  .btn-maps-external {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    color: var(--text-dark, #f1f5f9);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .btn-maps-external:hover {
    background-color: rgba(245, 158, 11, 0.15);
    border-color: var(--primary, #f59e0b);
    color: var(--primary, #f59e0b);
    transform: translateY(-1px);
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .review-card {
    background-color: var(--glass-bg-card, rgba(19, 23, 30, 0.75));
    backdrop-filter: var(--glass-blur, blur(16px));
    -webkit-backdrop-filter: var(--glass-blur, blur(16px));
    border: 1px solid var(--glass-border, rgba(255, 255, 255, 0.08));
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: transform var(--duration-fast, 200ms) ease,
                border-color var(--duration-fast, 200ms) ease,
                box-shadow var(--duration-fast, 200ms) ease;
  }

  .review-card:hover {
    transform: translateY(-4px);
    border-color: rgba(245, 158, 11, 0.3);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.3);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .author-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(245, 158, 11, 0.3);
    flex-shrink: 0;
  }

  .author-meta {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .author-name {
    font-family: var(--font-heading, sans-serif);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-dark, #f1f5f9);
  }

  .review-date {
    font-size: 0.78rem;
    color: var(--text-muted, #94a3b8);
  }

  .google-badge-mini {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.05);
    padding: 0.35rem;
    border-radius: 50%;
  }

  .card-rating {
    display: flex;
    gap: 0.15rem;
    color: var(--primary, #f59e0b);
    font-size: 1rem;
  }

  .review-text {
    font-size: 0.925rem;
    line-height: 1.6;
    color: #cbd5e1;
    font-style: italic;
  }

  @media (max-width: 768px) {
    .reviews-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
